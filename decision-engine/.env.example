AGENT_PRIVATE_KEY=0x_this_engines_own_signing_key_here
# Must match relayer/.env's RELAYER_PRIVATE_KEY exactly -- this engine calls relayer.js
# in-process, not over a network, and a mismatched key signs attestations that could never
# recover to the deployed contract's relayerAddress.
RELAYER_PRIVATE_KEY=0x_relayer_signing_key_here

# Self-hosted graph-node live query (see decision-engine/src/graph-client.js). URL has a safe
# default in config.js; the credentials do not -- get them from the password manager entry
# rotated 2026-09-06.
# GRAPH_NODE_URL=http://46.62.246.244:8000/subgraphs/name/robinhood-stock-market/price-feeds
GRAPH_NODE_USER=graphreader
GRAPH_NODE_PASSWORD=your_password_here

# Optional overrides for decision-engine/src/config.js -- see docs/spec.md "AI Decision Engine"
# before changing any of these (verification/decision/reference_model.py must stay in sync).
# MAX_BET_SIZE_WEI=1000000000000000
# PERCENTILE_HIGH_THRESHOLD=80
# PERCENTILE_LOW_THRESHOLD=20
# VOLATILITY_ANOMALY_RATIO=1.5
# QUERY_THROTTLE_MS=300000
